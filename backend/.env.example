# Optional duplicate template for reference only. Spring Boot imports ../.env from the backend directory.
# DATABASE_URL: JDBC URL for the local PostgreSQL database.
DATABASE_URL=jdbc:postgresql://localhost:5432/retail
# DATABASE_USERNAME: non-secret local PostgreSQL role name.
DATABASE_USERNAME=retail
# DATABASE_PASSWORD: required password for the local PostgreSQL role; leave blank here.
DATABASE_PASSWORD=
# ADMIN_USERNAME: username created for the first administrator on an empty database.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD: required for first startup; use a unique random secret, 20+ characters recommended.
ADMIN_PASSWORD=
# PORT: Spring Boot HTTP port.
PORT=8080

